{
    "name": "eslint-config-zoro",
    "version": "9.3.1",
    "description": "A fully customized ESLint configuration based on the default ESLint, React and TypeScript rules.",
    "packageManager": "pnpm@12.5.1",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "author": {
        "name": "nonoroazoro",
        "email": "xiaochao.k@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/nonoroazoro/eslint-config-zoro"
    },
    "keywords": [
        "config",
        "eslint",
        "eslintconfig",
        "node",
        "perfectionist",
        "react",
        "stylistic",
        "typescript"
    ],
    "scripts": {
        "prepare": "lefthook install",
        "prebuild": "npm run test && rimraf dist",
        "prepublish": "npm run build",
        "build": "tsc && tsc-alias && npm run lint",
        "lint": "eslint src/**",
        "test": "vitest run",
        "upgradepackages": "ncu -u"
    },
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
    },
    "dependencies": {
        "@stylistic/eslint-plugin": "^5.10.0",
        "eslint-plugin-perfectionist": "^5.11.1",
        "globals": "^17.12.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.2",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "dprint": "^0.57.4",
        "eslint": "^9.39.5",
        "eslint-plugin-n": "^18.3.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "lefthook": "^2.1.14",
        "npm-check-updates": "^23.1.0",
        "rimraf": "^6.1.3",
        "tsc-alias": "^1.9.5",
        "typescript": "^6.0.3",
        "vitest": "^5.0.1"
    },
    "peerDependencies": {
        "@typescript-eslint/eslint-plugin": ">=8.70.0 <9.0.0",
        "@typescript-eslint/parser": ">=8.70.0 <9.0.0",
        "eslint": ">=9.39.5 <10.0.0",
        "eslint-plugin-n": ">=18.3.0 <19.0.0",
        "eslint-plugin-react": ">=7.37.5 <8.0.0",
        "eslint-plugin-react-hooks": ">=7.1.1 <8.0.0"
    },
    "peerDependenciesMeta": {
        "@typescript-eslint/eslint-plugin": {
            "optional": true
        },
        "@typescript-eslint/parser": {
            "optional": true
        },
        "eslint-plugin-n": {
            "optional": true
        },
        "eslint-plugin-react": {
            "optional": true
        },
        "eslint-plugin-react-hooks": {
            "optional": true
        }
    },
    "files": [
        "dist"
    ]
}
